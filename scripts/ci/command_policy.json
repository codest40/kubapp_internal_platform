{
  "executables": [
    "sh",
    "bash",
    "zsh",
    "fish",
    "cmd",
    "powershell",
    "pwsh",

    "curl",
    "wget",
    "nc",
    "netcat",
    "socat",

    "ssh",
    "scp",
    "ftp",
    "telnet",

    "sudo",
    "su",

    "chmod",
    "chown",

    "mount",
    "umount",

    "dd",
    "mkfs",
    "fdisk",

    "iptables",
    "systemctl",

    "kill",
    "pkill"
  ],

  "operators": [
    "&&",
    "||",
    ";",
    "|",
    ">",
    ">>",
    "<",
    "$(",
    "`"
  ],

  "runtime_rules": {
    "python": {
      "blocked_arguments": [
        "-c",
        "--command"
      ],
      "blocked_file_extensions": [
        ".py"
      ]
    },

    "node": {
      "blocked_arguments": [
        "-e",
        "--eval",
        "-p",
        "--print"
      ],
      "blocked_file_extensions": [
        ".js",
        ".mjs",
        ".cjs"
      ]
    },

    "java": {
      "blocked_arguments": [],
      "blocked_file_extensions": [
        ".java"
      ]
    }
  }
}
